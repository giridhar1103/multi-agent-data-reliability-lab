# Demo is deterministic and uses no LLM. Live mode never silently falls back.
LAB_MODE=demo
LAB_MODEL=qwen3:8b
LAB_MODEL_BASE_URL=http://host.docker.internal:11434/v1
LAB_API_KEY=
LAB_MAX_MODEL_CALLS=8
LAB_MAX_OUTPUT_TOKENS=1200
LAB_MODEL_TIMEOUT=90
LAB_DATA_DIR=/data
# Set only when the observability profile is running:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces

